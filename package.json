{
    "name": "cdrl-platform",
    "private": true,
    "packageManager": "pnpm@9.15.3",
    "scripts": {
        "dev": "pnpm --filter web dev",
        "dev:api": "pnpm --filter api dev",
        "build": "pnpm --filter web build && pnpm --filter api build",
        "lint": "pnpm --filter web lint && pnpm --filter api lint",
        "prisma:migrate": "pnpm --filter api prisma migrate dev",
        "prisma:seed": "pnpm --filter api prisma db seed",
        "typecheck": "pnpm --filter api typecheck && pnpm --filter web exec tsc --noEmit",
        "test": "pnpm --filter api test && pnpm --filter web test",
        "prisma:generate": "pnpm --filter api prisma generate",
        "prisma:migrate:deploy": "pnpm --filter api prisma migrate deploy",
        "audit:prod": "pnpm audit --prod --audit-level=high"
    },
    "pnpm": {
        "overrides": {
            "postcss": ">=8.5.18",
            "sharp": ">=0.35.0",
            "brace-expansion@<2": ">=1.1.13",
            "brace-expansion@>=2": ">=2.0.2"
        }
    }
}
