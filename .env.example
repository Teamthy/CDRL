# ── Shared / API ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# PostgreSQL connection string (NEVER commit real credentials)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cdrl_dev
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:3000

# ── Web (inlined at BUILD time for the browser bundle) ───────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── API runtime ───────────────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_POINTS=6
RATE_LIMIT_DURATION=60
# Optional Redis URL — enables shared/distributed rate limiting
# REDIS_URL=redis://localhost:6379

# ── Optional SMTP notifier for contact enquiries ──────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# NOTIFY_EMAIL=training@example.com
