# ── Shared / API ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# PostgreSQL connection string (NEVER commit real credentials)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cdrl_dev
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:3000

# ── Web (inlined at BUILD time for the browser bundle) ───────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional: server-side override for SSR fetches inside container networks
# API_INTERNAL_URL=http://api:4000/api/v1
# Optional GA4 measurement ID. Analytics stays inert while this is unset.
# Build-time value — set it as a build arg too, not just at runtime.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── API runtime ───────────────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_POINTS=6
RATE_LIMIT_DURATION=60
# Optional Redis URL — enables shared/distributed rate limiting
# REDIS_URL=redis://localhost:6379

# ── Admin console ─────────────────────────────────────────────
# All three must be set or /api/v1/admin/login answers 503.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=            # min 10 chars
# ADMIN_JWT_SECRET=          # min 32 chars, e.g. `openssl rand -base64 48`

# ── Learner portal / LMS ──────────────────────────────────────
# REQUIRED to enable learner accounts. Without it, signup, login, password
# reset and every /api/v1/learner route answer 503 — the LMS looks broken
# rather than disabled. Min 32 chars: `openssl rand -base64 48`
# LEARNER_JWT_SECRET=
# Public origin of the WEB app, used to build learner-facing links (password
# reset emails, Paystack callback). Defaults to the first CORS_ORIGIN entry.
# PUBLIC_WEB_URL=http://localhost:3000

# ── Payments (Paystack) ───────────────────────────────────────
# Dormant until set: /api/v1/payments/* answer 503 and the UI falls back to
# the application flow. Use the sk_test_… key outside production.
# PAYSTACK_SECRET_KEY=

# ── Optional SMTP notifier for contact enquiries ──────────────
# Also used to email learner password-reset links. With SMTP unset the API
# logs the reset link instead, which is fine locally and NOT fine in prod.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# NOTIFY_EMAIL=training@example.com
