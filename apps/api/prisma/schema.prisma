generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id            String             @id @default(cuid())
  slug          String             @unique
  title         String
  subtitle      String
  track         String
  level         String
  deliveryMode  String
  overview      String
  details       String?            // patch-27: long-form markdown-lite body for detail pages
  priceKobo     Int?               // null/0 = not payable online (apply flow)
  priceBand     Json?              // patch-33: ROI/pricing bands, e.g. {individual: "₦...", corporate: "per-person"}
  trainers      CourseTrainer[]    // patch-33: instructors with trainer sub-pages
  currency      String             @default("NGN")
  published     Boolean            @default(true)
  sortOrder     Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  planItems     LearningPlanItem[]
  enrollments   Enrollment[]
  modules       CourseModule[]
  purchases     Purchase[]
  recordings    Recording[]
  bundles       BundleCourse[]

  @@index([published, track])
}

model SiteContent {
  id        String   @id @default(cuid())
  pageKey   String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactEnquiry {
  id           String   @id @default(cuid())
  name         String
  email        String?
  organization String?
  interest     String
  message      String
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LearningPlan {
  id        String           @id @default(cuid())
  sessionId String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     LearningPlanItem[]
}

model LearningPlanItem {
  id             String       @id @default(cuid())
  learningPlanId String
  courseId       String
  createdAt      DateTime     @default(now())
  learningPlan   LearningPlan @relation(fields: [learningPlanId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([learningPlanId, courseId])
  @@index([courseId])
}

model Event {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  summary         String
  body            String?
  location        String?
  startsAt        DateTime
  endsAt          DateTime?
  registrationUrl String?
  eventType       String    @default("cohort") // patch-33: cohort | exam | webinar | briefing
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, startsAt])
}

model Post {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  category      String
  excerpt       String
  body          String
  coverImageUrl String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Application {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  courseSlug  String?
  courseTitle String?
  track       String?
  background  String?
  message     String?
  status      String   @default("new")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model LmsUser {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  role         String       @default("student")
  status       String       @default("active")
  passwordHash String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  enrollments  Enrollment[] @relation("StudentEnrollments")
  tutoring     Enrollment[] @relation("TutorAssignments")
  refreshTokens RefreshToken[]
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  tutorId   String?
  status    String   @default("active")
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   LmsUser  @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  tutor     LmsUser? @relation("TutorAssignments", fields: [tutorId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@index([tutorId])
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  body      String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
}

model Purchase {
  id          String   @id @default(cuid())
  reference   String   @unique
  email       String
  name        String?
  courseSlug  String
  amountKobo  Int
  currency    String   @default("NGN")
  status      String   @default("pending")   // pending | success | failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  paidAt      DateTime?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId    String?

  @@index([status, createdAt])
  @@index([email])
}

model Recording {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  url         String
  description String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      LmsUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}


// ── patch-33: PECB-parity surfaces ────────────────────────────────────────────

model Trainer {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  title     String          // e.g. "Lead Auditor · Information Security"
  bio       String
  focus     String          // areas, e.g. "ISO/IEC 27001 · ISO 22301"
  photoUrl  String?
  linkedIn  String?
  published Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  courses   CourseTrainer[]

  @@index([published])
}

model CourseTrainer {
  id        String  @id @default(cuid())
  courseId  String
  trainerId String
  role      String  @default("Lead instructor") // Lead instructor | Co-tutor | Guest expert
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([courseId, trainerId])
  @@index([trainerId])
}

model Bundle {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  subtitle       String
  overview       String
  details        String?
  priceKobo      Int?           // null = quote/Enquire; 0 = free
  currency       String         @default("NGN")
  savingsNote    String?        // e.g. "Save ₦120,000 vs buying separately"
  published      Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  courses        BundleCourse[]

  @@index([published])
}

model BundleCourse {
  id       String @id @default(cuid())
  bundleId String
  courseId String
  order    Int    @default(0)
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([bundleId, courseId])
  @@index([courseId])
}
