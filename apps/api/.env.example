# apps/api environment — copy to apps/api/.env for local dev. NEVER commit real values.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cdrl_dev
PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_POINTS=6
RATE_LIMIT_DURATION=60
# REDIS_URL=redis://localhost:6379

# ── Admin console (all three required, or /admin/login returns 503) ──
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=            # min 10 chars
# ADMIN_JWT_SECRET=          # min 32 chars: openssl rand -base64 48

# ── Learner portal / LMS ──
# REQUIRED to enable learner accounts. Without it every /learner route —
# signup, login, forgot-password, reset-password — answers 503.
# LEARNER_JWT_SECRET=        # min 32 chars: openssl rand -base64 48
# Public origin of the WEB app, for learner-facing links (reset emails,
# payment callback). Defaults to the first CORS_ORIGIN entry.
# PUBLIC_WEB_URL=http://localhost:3000

# ── Payments (Paystack) ──
# Dormant until set: /payments/* answer 503 and the UI offers the apply flow.
# PAYSTACK_SECRET_KEY=       # sk_test_… outside production

# ── Optional SMTP notifier (contact enquiries + learner reset emails) ──
# With SMTP unset the API logs reset links instead of mailing them.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# NOTIFY_EMAIL=
