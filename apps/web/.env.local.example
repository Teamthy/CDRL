# ═══════════════════════════════════════════════════════════════
# CDRL Frontend — Environment Variables
# Copy this file to .env.local for local development.
# ═══════════════════════════════════════════════════════════════

# Public site URL (used for canonical, OpenGraph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL (Node/Express service).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional legacy alias — kept for compatibility with older layout.tsx.
WEB_URL=http://localhost:3000